(**
  Implementation of a two-party mutual authentication (MA) protocol using a
  variant of the Needham-Schroeder-Lowe protocol.
*)
module MA.NSL

open SymbolicTypes

open AencTerms

open MA.Types

open Bag

module Protocol = Protocol

module PartialMap = FStar.PartialMap

module Set = FStar.Set



/// -------------------------------------------------------------------------
/// Protocol typeclass instance for the NSL-based MA implementation.
/// -------------------------------------------------------------------------

/// State tracked for participant-local initiator sessions that have already started.

noeq
type initiator_session_state = {
  initiator: participant_id;
  responder: participant_id;
  initiator_nonce: nonce;
  ack_sent: bool;
  output_sent: bool
}

/// State tracked for participant-local responder sessions that have already replied.

noeq
type responder_session_state = {
  responder: participant_id;
  initiator: participant_id;
  responder_nonce: nonce;
  output_sent: bool
}

noeq
type participant_session_state =
  | InitiatorSession: initiator_session_state -> participant_session_state
  | ResponderSession: responder_session_state -> participant_session_state

type participant_session_map = PartialMap.t session_id participant_session_state

/// Internal protocol state. Participant-local states are indexed first by
/// participant and then by logical session.
noeq
type impl_internal_state = {
  key_directory: PartialMap.t participant_id priv_key;
  // Monotone set of all nonces generated by this protocol or already present
  // in the initial adversary knowledge. Freshness is `not mem` in this set.
  used_nonces: Set.set nonce;
  participant_sessions: PartialMap.t participant_id participant_session_map
}

/// Type alias for the NSL protocol state, before being composed with a tester.
type impl_proto_state = Protocol.state term impl_internal_state

unfold
let ma_participant_sessions
      (s: impl_proto_state)
      (participant: participant_id)
    : participant_session_map =
  match PartialMap.sel s.internal.participant_sessions participant with
  | Some participant_sessions -> participant_sessions
  | None -> PartialMap.empty session_id participant_session_state

let ma_get_participant_session_state
      (s: impl_proto_state)
      (participant: participant_id)
      (session: session_id)
    : option participant_session_state =
  PartialMap.sel (ma_participant_sessions s participant) session

unfold
let ma_initiator_session_state
      (s: impl_proto_state)
      (initiator: participant_id)
      (session: session_id)
    : option initiator_session_state =
  match ma_get_participant_session_state s initiator session with
  | Some (InitiatorSession initiator_state) -> Some initiator_state
  | _ -> None

unfold
let ma_responder_session_state
      (s: impl_proto_state)
      (responder: participant_id)
      (session: session_id)
    : option responder_session_state =
  match ma_get_participant_session_state s responder session with
  | Some (ResponderSession responder_state) -> Some responder_state
  | _ -> None

unfold
let ma_update_participant_session_state
      (s: impl_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: participant_session_state)
    : impl_proto_state =
  {
    s with
    internal =
    {
      s.internal with
      participant_sessions =
        PartialMap.upd s.internal.participant_sessions participant
          (PartialMap.upd (ma_participant_sessions s participant) session session_state)
    }
  }

val ma_get_participant_session_state_after_update_same
      (s: impl_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: participant_session_state)
    : Lemma
      (ensures (
        let s' = ma_update_participant_session_state s participant session session_state
        in
        ma_get_participant_session_state s' participant session == Some session_state
      ))

val ma_get_participant_session_state_after_update_different
      (s: impl_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: participant_session_state)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (requires (query_participant <> participant \/ query_session <> session))
      (ensures (
        let s' = ma_update_participant_session_state s participant session session_state
        in
        ma_get_participant_session_state s' query_participant query_session ==
        ma_get_participant_session_state s query_participant query_session
      ))

unfold
let nonce_in_participant_session_state
      (participant_session_state: participant_session_state)
      (n: nonce)
    : prop =
  match participant_session_state with
  | InitiatorSession initiator_state ->
    initiator_state.initiator_nonce == n
  | ResponderSession responder_state ->
    responder_state.responder_nonce == n

unfold
let ma_nsl_nonce_is_fresh
      (s: impl_proto_state)
      (fresh_nonce: nonce)
    : prop =
  not (Set.mem fresh_nonce s.internal.used_nonces)

(**
  Network messages sent by the NSL protocol.

  The session id is part of the encrypted plaintext to ensure integrity. If the
  session id is outside the ciphertext, an adversary can replay the same opaque
  ciphertext under a different public session tag and force the two parties to
  authenticate while disagreeing about which session was authenticated.
*)
let ma_nsl_message1_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  Aenc
    (Pair (SessionId session)
      (Pair (Nonce initiator_nonce)
        (ParticipantId initiator)))
    (PubKey?.priv responder_pubkey)

let ma_nsl_message2_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : term =
  Aenc
    (Pair (SessionId session)
      (Pair (Nonce initiator_nonce)
        (Pair (Nonce responder_nonce)
          (ParticipantId responder))))
    (PubKey?.priv initiator_pubkey)

let ma_nsl_message3_term
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  Aenc
    (Pair (SessionId session) (Nonce responder_nonce))
    (PubKey?.priv responder_pubkey)

(**
  Variants of the sent terms that are tagged with the Net channel to indicate
  they are sent over the network, rather than over the IO channel.
*)
let ma_nsl_message1_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message1_term session initiator responder initiator_nonce responder_pubkey)

let ma_nsl_message2_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message2_term session initiator responder initiator_nonce responder_nonce initiator_pubkey)

let ma_nsl_message3_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message3_term session initiator responder responder_nonce responder_pubkey)



/// (`nsl_initiator_start`) Initiator start: consume `Auth(i, A, B, initiator)`, generate the
/// initiator nonce, and emit the first encrypted NSL message.

unfold
let ma_nsl_initiator_start_enabled
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : prop =
  PartialMap.sel s.internal.key_directory responder == Some (PubKey?.priv responder_pubkey) /\
  not (PartialMap.contains (ma_participant_sessions s initiator) session) /\
  ma_nsl_nonce_is_fresh s initiator_nonce /\
  Bag.mem (ma_auth_input_term session initiator responder Initiator) s.inputs

let ma_nsl_initiator_start_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : impl_proto_state =
  let s' = ma_update_participant_session_state s initiator session
    (InitiatorSession
      {
      initiator = initiator;
      responder = responder;
      initiator_nonce = initiator_nonce;
      ack_sent = false;
      output_sent = false
      })
  in
  {
    s' with
    inputs = Bag.remove (ma_auth_input_term session initiator responder Initiator) s.inputs;
    internal = { s'.internal with used_nonces = Set.add initiator_nonce s.internal.used_nonces }
  }

(**
  Lemmas characterizing the new state from executing
  `ma_nsl_initiator_start_transition`. These allow for reasoning about the new
  state without needing to unfold the changes, which could otherwise lead to
  flaky proofs.
*)
val ma_nsl_initiator_start_state_inputs_eq
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).inputs ==
        Bag.remove (ma_auth_input_term session initiator responder Initiator) s.inputs)
      [SMTPat (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).inputs]

val ma_nsl_initiator_start_state_preserves_key_directory
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).internal.key_directory]

val ma_nsl_initiator_start_state_preserves_used_nonces
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).internal.used_nonces ==
        Set.add initiator_nonce s.internal.used_nonces)
      [SMTPat (ma_nsl_initiator_start_state s session initiator responder initiator_nonce).internal.used_nonces]

val ma_nsl_initiator_start_state_get_updated_participant_session_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures (
        let s' = ma_nsl_initiator_start_state s session initiator responder initiator_nonce in
        if query_participant = initiator && query_session = session then
          ma_get_participant_session_state s' query_participant query_session ==
          Some (InitiatorSession
            {
              initiator = initiator;
              responder = responder;
              initiator_nonce = initiator_nonce;
              ack_sent = false;
              output_sent = false
            })
        else
          ma_get_participant_session_state s' query_participant query_session ==
          ma_get_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_participant_session_state
        (ma_nsl_initiator_start_state s session initiator responder initiator_nonce)
        query_participant query_session)]

let ma_nsl_initiator_start_transition
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (sent_t: term)
      (s': impl_proto_state)
    : prop =
  exists (initiator_nonce: nonce)
         (responder_pubkey: term {PubKey? responder_pubkey}).
    ma_nsl_initiator_start_enabled s session initiator responder initiator_nonce responder_pubkey /\
    sent_t == ma_nsl_message1_term session initiator responder initiator_nonce responder_pubkey /\
    s' == ma_nsl_initiator_start_state s session initiator responder initiator_nonce



/// (`nsl_responder_reply`) Responder reply: consume `Auth(i, B, A, responder)` and the first
/// network message, then emit the second NSL message containing both nonces.

unfold
let ma_nsl_responder_reply_enabled
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce: nonce)
      (responder_nonce: nonce)
      (responder_key: priv_key)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : prop =
  PartialMap.sel s.internal.key_directory responder == Some responder_key /\
  PartialMap.sel s.internal.key_directory initiator == Some (PubKey?.priv initiator_pubkey) /\
  not (PartialMap.contains (ma_participant_sessions s responder) session) /\
  ma_nsl_nonce_is_fresh s responder_nonce /\
  Bag.mem (ma_auth_input_term session responder initiator Responder) s.inputs /\
  Bag.mem (ma_nsl_message1_network_term
    session initiator responder initiator_nonce (PubKey responder_key)) s.inputs

let ma_nsl_responder_reply_state
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : impl_proto_state =
  let s' = ma_update_participant_session_state s responder session
    (ResponderSession
      {
      responder = responder;
      initiator = initiator;
      responder_nonce = responder_nonce;
      output_sent = false
      })
  in
  {
    s' with
    inputs = Bag.remove (ma_auth_input_term session responder initiator Responder)
      (Bag.remove (ma_nsl_message1_network_term
        session initiator responder initiator_nonce (PubKey responder_key))
        s.inputs);
    internal = { s'.internal with used_nonces = Set.add responder_nonce s.internal.used_nonces }
  }

(**
  Lemmas characterizing the new state from executing
  `ma_nsl_responder_reply_transition`. These allow for reasoning about the new
  state without needing to unfold the changes, which could otherwise lead to
  flaky proofs.
*)
val ma_nsl_responder_reply_state_inputs_eq
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : Lemma
      (ensures
        (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).inputs ==
        Bag.remove (ma_auth_input_term session responder initiator Responder)
          (Bag.remove (ma_nsl_message1_network_term
            session initiator responder initiator_nonce (PubKey responder_key))
            s.inputs))
      [SMTPat (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).inputs]

val ma_nsl_responder_reply_state_preserves_key_directory
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : Lemma
      (ensures
        (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).internal.key_directory]

val ma_nsl_responder_reply_state_preserves_used_nonces
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : Lemma
      (ensures
        (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).internal.used_nonces ==
        Set.add responder_nonce s.internal.used_nonces)
      [SMTPat (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key).internal.used_nonces]

val ma_nsl_responder_reply_state_get_updated_participant_session_state
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures (
        let s' = ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key in
        if query_participant = responder && query_session = session then
          ma_get_participant_session_state s' query_participant query_session ==
          Some (ResponderSession
            {
              responder = responder;
              initiator = initiator;
              responder_nonce = responder_nonce;
              output_sent = false
            })
        else
          ma_get_participant_session_state s' query_participant query_session ==
          ma_get_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_participant_session_state
        (ma_nsl_responder_reply_state s session responder initiator initiator_nonce responder_nonce responder_key)
        query_participant query_session)]

let ma_nsl_responder_reply_transition
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (sent_t: term)
      (s': impl_proto_state)
    : prop =
  exists (initiator_nonce responder_nonce: nonce)
         (responder_key: priv_key)
         (initiator_pubkey: term {PubKey? initiator_pubkey}).
    ma_nsl_responder_reply_enabled
      s session responder initiator initiator_nonce responder_nonce responder_key initiator_pubkey /\
    sent_t == ma_nsl_message2_term
      session initiator responder initiator_nonce responder_nonce initiator_pubkey /\
    s' == ma_nsl_responder_reply_state
      s session responder initiator initiator_nonce responder_nonce responder_key



/// (`nsl_initiator_ack`) Initiator acknowledgment: consume the responder's message, check it
/// against the stored initiator-session information, and emit the third NSL
/// message containing the responder nonce.

unfold
let ma_nsl_initiator_ack_enabled
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : prop =
  match ma_initiator_session_state s initiator session with
  | Some initiator_state ->
    initiator_state.initiator == initiator /\
    initiator_state.responder == responder /\
    not initiator_state.ack_sent /\
    PartialMap.sel s.internal.key_directory initiator == Some initiator_key /\
    PartialMap.sel s.internal.key_directory responder == Some (PubKey?.priv responder_pubkey) /\
    Bag.mem (ma_nsl_message2_network_term
      session initiator responder initiator_state.initiator_nonce responder_nonce
      (PubKey initiator_key)) s.inputs
  | None -> False

let ma_nsl_initiator_ack_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : impl_proto_state =
  match ma_initiator_session_state s initiator session with
  | Some initiator_state ->
    let s' = ma_update_participant_session_state s initiator session
      (InitiatorSession { initiator_state with ack_sent = true })
    in
    {
      s' with
      inputs = Bag.remove (ma_nsl_message2_network_term
        session initiator responder initiator_state.initiator_nonce responder_nonce
        (PubKey initiator_key))
        s.inputs
    }
  | None -> s

(**
  Lemmas characterizing the new state from executing
  `ma_nsl_initiator_ack_transition`. These allow for reasoning about the new
  state without needing to unfold the changes, which could otherwise lead to
  flaky proofs.
*)
val ma_nsl_initiator_ack_state_inputs_eq
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Lemma
      (requires Some? (ma_initiator_session_state s initiator session))
      (ensures (
        let initiator_state = Some?.v (ma_initiator_session_state s initiator session) in
        (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).inputs ==
          Bag.remove (ma_nsl_message2_network_term
            session initiator responder initiator_state.initiator_nonce responder_nonce
            (PubKey initiator_key)) s.inputs
      ))
      [SMTPat (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).inputs]

val ma_nsl_initiator_ack_state_preserves_key_directory
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Lemma
      (ensures
        (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).internal.key_directory]

val ma_nsl_initiator_ack_state_preserves_used_nonces
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Lemma
      (ensures
        (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).internal.used_nonces ==
        s.internal.used_nonces)
      [SMTPat (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key).internal.used_nonces]

val ma_nsl_initiator_ack_state_get_updated_participant_session_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (requires Some? (ma_initiator_session_state s initiator session))
      (ensures (
        let s' = ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key in
        let initiator_state = Some?.v (ma_initiator_session_state s initiator session) in
        if query_participant = initiator && query_session = session then
          ma_get_participant_session_state s' query_participant query_session ==
          Some (InitiatorSession { initiator_state with ack_sent = true })
        else
          ma_get_participant_session_state s' query_participant query_session ==
          ma_get_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_participant_session_state
        (ma_nsl_initiator_ack_state s session initiator responder responder_nonce initiator_key)
        query_participant query_session)]

let ma_nsl_initiator_ack_transition
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (sent_t: term)
      (s': impl_proto_state)
    : prop =
  exists (responder_nonce: nonce)
         (initiator_key: priv_key)
         (responder_pubkey: term {PubKey? responder_pubkey}).
    ma_nsl_initiator_ack_enabled
      s session initiator responder responder_nonce initiator_key responder_pubkey /\
    sent_t == ma_nsl_message3_term
      session initiator responder responder_nonce responder_pubkey /\
    s' == ma_nsl_initiator_ack_state
      s session initiator responder responder_nonce initiator_key



/// (`nsl_initiator_output`) Initiator output: once the acknowledgment was sent, emit
/// `Authenticated(i, A, B)` exactly once.

unfold
let ma_nsl_initiator_output_enabled
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
    : prop =
  match ma_initiator_session_state s initiator session with
  | Some initiator_state ->
    initiator_state.initiator == initiator /\
    initiator_state.responder == responder /\
    initiator_state.ack_sent /\
    not initiator_state.output_sent
  | None -> False

let ma_nsl_initiator_output_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
    : impl_proto_state =
  match ma_initiator_session_state s initiator session with
  | Some initiator_state ->
    ma_update_participant_session_state s initiator session
      (InitiatorSession { initiator_state with output_sent = true })
  | None -> s

val ma_nsl_initiator_output_state_preserves_inputs
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
    : Lemma
      (ensures (ma_nsl_initiator_output_state s session initiator responder).inputs == s.inputs)
      [SMTPat (ma_nsl_initiator_output_state s session initiator responder).inputs]

val ma_nsl_initiator_output_state_preserves_key_directory
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
    : Lemma
      (ensures
        (ma_nsl_initiator_output_state s session initiator responder).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_nsl_initiator_output_state s session initiator responder).internal.key_directory]

val ma_nsl_initiator_output_state_preserves_get_participant_session_state
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (requires Some? (ma_initiator_session_state s initiator session))
      (ensures (
        let s' = ma_nsl_initiator_output_state s session initiator responder in
        let initiator_state = Some?.v (ma_initiator_session_state s initiator session) in
        if query_participant = initiator && query_session = session then
            ma_get_participant_session_state s' query_participant query_session ==
              Some (InitiatorSession { initiator_state with output_sent = true })
        else
          ma_get_participant_session_state s' query_participant query_session ==
          ma_get_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_participant_session_state
        (ma_nsl_initiator_output_state s session initiator responder)
        query_participant query_session)]

val ma_nsl_initiator_output_state_preserves_freshness
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (fresh_nonce: nonce)
  : Lemma
    (requires Some? (ma_initiator_session_state s initiator session))
    (ensures (
      let s' = ma_nsl_initiator_output_state s session initiator responder in
      ma_nsl_nonce_is_fresh s' fresh_nonce <==> ma_nsl_nonce_is_fresh s fresh_nonce
    ))
    [SMTPat (ma_nsl_nonce_is_fresh
      (ma_nsl_initiator_output_state s session initiator responder)
      fresh_nonce)]

let ma_nsl_initiator_output_transition
      (s: impl_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (output_t: term)
      (s': impl_proto_state)
    : prop =
  ma_nsl_initiator_output_enabled s session initiator responder /\
  output_t == ma_authenticated_term session initiator responder /\
  s' == ma_nsl_initiator_output_state s session initiator responder



/// (`nsl_responder_output`) Responder output: consume the acknowledgment message and emit
/// `Authenticated(i, B, A)` exactly once.

unfold
let ma_nsl_responder_output_enabled
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (responder_key: priv_key)
    : prop =
  match ma_responder_session_state s responder session with
  | Some responder_state ->
    responder_state.responder == responder /\
    responder_state.initiator == initiator /\
    not responder_state.output_sent /\
    PartialMap.sel s.internal.key_directory responder == Some responder_key /\
    Bag.mem (ma_nsl_message3_network_term
      session initiator responder responder_state.responder_nonce (PubKey responder_key)) s.inputs
  | None -> False

let ma_nsl_responder_output_state
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (responder_key: priv_key)
    : impl_proto_state =
  match ma_responder_session_state s responder session with
  | Some responder_state ->
    let s' = ma_update_participant_session_state s responder session
      (ResponderSession { responder_state with output_sent = true })
    in
    {
      s' with
      inputs = Bag.remove (ma_nsl_message3_network_term
        session initiator responder responder_state.responder_nonce (PubKey responder_key))
        s.inputs
    }
  | None -> s

let ma_nsl_responder_output_transition
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (output_t: term)
      (s': impl_proto_state)
    : prop =
  exists (responder_key: priv_key).
    ma_nsl_responder_output_enabled s session responder initiator responder_key /\
    output_t == ma_authenticated_term session responder initiator /\
    s' == ma_nsl_responder_output_state s session responder initiator responder_key

val ma_nsl_responder_output_state_preserves_get_participant_session_state
      (s: impl_proto_state)
      (session: session_id)
      (responder initiator: participant_id)
      (responder_key: priv_key)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (requires Some? (ma_responder_session_state s responder session))
      (ensures (
        let s' = ma_nsl_responder_output_state s session responder initiator responder_key in
        let responder_state = Some?.v (ma_responder_session_state s responder session) in
        if query_participant = responder && query_session = session then
          ma_get_participant_session_state s' query_participant query_session ==
          Some (ResponderSession { responder_state with output_sent = true })
        else
          ma_get_participant_session_state s' query_participant query_session ==
          ma_get_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_participant_session_state
        (ma_nsl_responder_output_state s session responder initiator responder_key)
        query_participant query_session)]



let ma_nsl_protocol_transition
      (s: impl_proto_state)
      (l: Protocol.label term ma_effect ma_label_id)
      (s': impl_proto_state)
    : prop =
  match l with
  | Protocol.Observable NetSend t lid ->
    (match lid.role with
     | Initiator ->
       ma_nsl_initiator_start_transition s lid.session lid.party lid.peer t s' \/
       ma_nsl_initiator_ack_transition s lid.session lid.party lid.peer t s'
     | Responder ->
       ma_nsl_responder_reply_transition s lid.session lid.party lid.peer t s')
  | Protocol.Observable IoSend t lid ->
    (match lid.role with
     | Initiator ->
       ma_nsl_initiator_output_transition s lid.session lid.party lid.peer t s'
     | Responder ->
       ma_nsl_responder_output_transition s lid.session lid.party lid.peer t s')
  | Protocol.Internal _ -> False

let ma_nsl_protocol_init
      (key_directory: PartialMap.t participant_id priv_key)
      (initial_used_nonces: Set.set nonce)
    : impl_proto_state =
  {
    inputs = Bag.empty;
    internal =
    {
      key_directory = key_directory;
      used_nonces = initial_used_nonces;
      participant_sessions = PartialMap.empty participant_id participant_session_map
    }
  }



/// `valid_transitions` holds because each transition either leaves the input bag
/// unchanged or removes one or more trigger terms with `Bag.remove`.

val ma_nsl_valid_transitions
      (s: impl_proto_state)
      (l: Protocol.label term ma_effect ma_label_id)
      (s': impl_proto_state)
    : squash (ma_nsl_protocol_transition s l s' ==> Bag.subset s'.inputs s.inputs)

[@@ FStar.Tactics.Typeclasses.tcinstance]
let ma_nsl_protocol_with_used_nonces
      (key_directory: PartialMap.t participant_id priv_key)
      (initial_used_nonces: Set.set nonce)
    : Protocol.protocol term ma_effect ma_label_id impl_internal_state =
  {
    transition = ma_nsl_protocol_transition;
    init = ma_nsl_protocol_init key_directory initial_used_nonces;
    valid_transitions = ma_nsl_valid_transitions
  }

let ma_nsl_protocol
      (key_directory: PartialMap.t participant_id priv_key)
    : Protocol.protocol term ma_effect ma_label_id impl_internal_state =
  ma_nsl_protocol_with_used_nonces key_directory Set.empty
