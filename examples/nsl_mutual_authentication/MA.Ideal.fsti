module MA.Ideal

open SymbolicTypes

open AencTerms

open AdversaryAenc

open MA.Adversary

open MA.Types

module Set = FStar.Set

open FStar.Set.Properties

module PartialMap = FStar.PartialMap

module Seq = FStar.Seq

open Bag

module Protocol = Protocol

/// -------------------------------------------------------------------------
/// Protocol typeclass instance for the Mutual Authentication (MA) ideal
/// functionality and simulator.
/// -------------------------------------------------------------------------

/// Authentication requests are tracked explicitly so delivery can later check
/// that both complementary directions have been requested.
type auth_request = {
  party: participant_id;
  peer: participant_id;
  role: role
}

/// Simulator-side state corresponding to a participant-local initiator
/// state that has already caused the first NSL message to be emitted.
noeq
type sim_initiator_session_state = {
  initiator: participant_id;
  responder: participant_id;
  initiator_nonce: nonce;
  ack_sent: bool
}

/// Simulator-side state corresponding to a participant-local responder state
/// that has already caused the second NSL message to be emitted.
noeq
type sim_responder_session_state = {
  responder: participant_id;
  initiator: participant_id;
  responder_nonce: nonce;
  output_forwarded: bool
}

noeq
type sim_participant_session_state =
  | SimInitiatorSession: sim_initiator_session_state -> sim_participant_session_state
  | SimResponderSession: sim_responder_session_state -> sim_participant_session_state

type sim_participant_session_map = PartialMap.t session_id sim_participant_session_state

/// Internal state for the MA ideal and simulator protocols. The adversary
/// knowledge is tracked separately by `TestedSystem`.
noeq
type ideal_internal_state = {
  // Public-key directory used by the simulator so its emitted ciphertexts use
  // the same per-party keys as the implementation.
  key_directory: PartialMap.t participant_id priv_key;

  // Static set of corrupted participants. The adversary is allowed to know
  // private keys for corrupt participants and nonces for sessions where at
  // least one of the initiator or responder is corrupt.
  corrupt: Set.set participant_id;

  // Per-session authentication requests received by the ideal functionality.
  requests : PartialMap.t session_id (Set.set auth_request);

  // Monotone set of all nonces generated by the simulator or already present
  // in the initial adversary knowledge. Freshness is `not mem` in this set.
  used_nonces: Set.set nonce;

  // Pending notifications from the ideal functionality to the simulator. Each
  // element represents one leaked `Authenticating(i, p, p', r)` fact that the
  // simulator may now expose on the network.
  ideal_to_sim_channel:Set.set term;

  // Pending delivery commands `Output(i, p)` that the simulator has consumed
  // from the adversary and forwarded to the ideal functionality.
  sim_to_ideal_channel:Set.set term;

  // Simulator-side session state is indexed first by participant and then by
  // logical session, with each participant/session entry storing exactly one
  // role-local state.
  sim_participant_sessions: PartialMap.t participant_id sim_participant_session_map
}

/// Type alias for the ideal-plus-simulator protocol state before tester composition.
type ideal_proto_state = Protocol.state term ideal_internal_state


(**
----------------------------------------------------------------------------
  Individual ideal and simulator transitions at the Protocol level.

  The mutual authentication ideal functionality works as follows:

  1. Initiation and Leakage
  - Input: Any party p may attempt to authenticate with another party p' for a
    session i by passing the input Auth(i, p, p', r) to the ideal functionality,
    where r is the role for party p for this session (either initiator or
    responder). This input is only accepted if a request from party `p` has not
    already been stored for session `i`.
  - Leakage: Upon receiving this input, the functionality leaks the term
    Authenticating(i, p, p', r) to the adversary S over the backdoor channel.

  2. Adversary Delivery and Output
  - Trigger: The functionality waits to receive a delivery command Output(i, p)
    from the adversary S over the backdoor channel.
  - Output: If the functionality has received the authentication request for p
    and the complementary request from p', then outputs Authenticated(i, p, p').
*)

let complementary_request
      (party peer: participant_id)
      (r: role)
    : auth_request =
  {
    party = peer;
    peer = party;
    role = complementary_role r
  }

/// Ideal-only leakage and delivery commands are encoded with additional
/// pair-tree shapes on top of the common MA input/output encodings.

let ma_authenticating_term
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : term =
  match r with
  | Initiator ->
    Pair (ma_auth_input_payload_term session party peer r) (SessionId session)
  | Responder ->
    Pair (SessionId session) (ma_auth_input_payload_term session party peer r)

let ma_output_term
      (session: session_id)
      (party: participant_id)
    : term =
  Pair (SessionId session) (ParticipantId party)

/// The simulator emits the same three NSL message shapes as the implementation.
/// This preserves the participant identifiers, the key used for each
/// encryption, and the nonce equalities that become visible if the adversary
/// later decrypts with a known private key.  The session id is also inside the
/// encrypted plaintext.  Keeping it only as a public wrapper would let an
/// adversary re-tag an opaque ciphertext with a different session id, causing
/// the peers to authenticate while associating the run with different sessions.

let ma_nsl_message1_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  Aenc
    (Pair (SessionId session)
      (Pair (Nonce initiator_nonce)
        (ParticipantId initiator)))
    (PubKey?.priv responder_pubkey)

let ma_nsl_message2_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : term =
  Aenc
    (Pair (SessionId session)
      (Pair (Nonce initiator_nonce)
        (Pair (Nonce responder_nonce)
          (ParticipantId responder))))
    (PubKey?.priv initiator_pubkey)

let ma_nsl_message3_term
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  Aenc
    (Pair (SessionId session) (Nonce responder_nonce))
    (PubKey?.priv responder_pubkey)

let ma_nsl_message1_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message1_term session initiator responder initiator_nonce responder_pubkey)

let ma_nsl_message2_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message2_term session initiator responder initiator_nonce responder_nonce initiator_pubkey)

let ma_nsl_message3_network_term
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : term =
  ma_net_input_term
    (ma_nsl_message3_term session initiator responder responder_nonce responder_pubkey)

let ma_session_requests
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
    : Set.set auth_request =
  match PartialMap.sel s.internal.requests session with
  | Some requests -> requests
  | None -> Set.empty

unfold
let ma_existing_requests_are_complementary
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : prop =
  let complementary_request = complementary_request party peer r in
  forall (stored_request: auth_request).
    Set.mem stored_request (ma_session_requests s session) ==>
    stored_request == complementary_request

unfold
let ma_sim_participant_sessions
      (s: Protocol.state term ideal_internal_state)
      (participant: participant_id)
    : sim_participant_session_map =
  match PartialMap.sel s.internal.sim_participant_sessions participant with
  | Some participant_sessions -> participant_sessions
  | None -> PartialMap.empty session_id sim_participant_session_state

let ma_get_sim_participant_session_state
      (s: ideal_proto_state)
      (participant: participant_id)
      (session: session_id)
    : option sim_participant_session_state =
  PartialMap.sel (ma_sim_participant_sessions s participant) session

let ma_sim_initiator_session_state
      (s: Protocol.state term ideal_internal_state)
      (initiator: participant_id)
      (session: session_id)
    : option sim_initiator_session_state =
  match ma_get_sim_participant_session_state s initiator session with
  | Some (SimInitiatorSession initiator_state) -> Some initiator_state
  | _ -> None

let ma_sim_responder_session_state
      (s: Protocol.state term ideal_internal_state)
      (responder: participant_id)
      (session: session_id)
    : option sim_responder_session_state =
  match ma_get_sim_participant_session_state s responder session with
  | Some (SimResponderSession responder_state) -> Some responder_state
  | _ -> None

let unfold_ma_sim_initiator_session_state
      (s: Protocol.state term ideal_internal_state)
      (initiator: participant_id)
      (session: session_id)
    : Lemma
      (ensures (
        ma_sim_initiator_session_state s initiator session == (
        match ma_get_sim_participant_session_state s initiator session with
        | Some (SimInitiatorSession initiator_state) -> Some initiator_state
        | _ -> None
      )))
      // [SMTPat (ma_sim_initiator_session_state s initiator session)]
= ()

let unfold_ma_sim_responder_session_state
      (s: Protocol.state term ideal_internal_state)
      (responder: participant_id)
      (session: session_id)
    : Lemma
      (ensures (
        ma_sim_responder_session_state s responder session ==
        (match ma_get_sim_participant_session_state s responder session with
        | Some (SimResponderSession responder_state) -> Some responder_state
        | _ -> None
      )))
      // [SMTPat (ma_sim_responder_session_state s responder session)]
= ()

let participant_session_eq_implies_initiator_session_eq
  (s: ideal_proto_state)
  (participant: participant_id)
  (session: session_id)
  (s': ideal_proto_state)
  (participant': participant_id)
  (session': session_id)
  : Lemma
    (requires
      ma_get_sim_participant_session_state s participant session
      ==
      ma_get_sim_participant_session_state s' participant' session')
    (ensures
      ma_sim_initiator_session_state s participant session
      ==
      ma_sim_initiator_session_state s' participant' session')
= ()

let participant_session_eq_implies_responder_session_eq
  (s: ideal_proto_state)
  (participant: participant_id)
  (session: session_id)
  (s': ideal_proto_state)
  (participant': participant_id)
  (session': session_id)
  : Lemma
    (requires
      ma_get_sim_participant_session_state s participant session
      ==
      ma_get_sim_participant_session_state s' participant' session')
    (ensures
      ma_sim_responder_session_state s participant session
      ==
      ma_sim_responder_session_state s' participant' session')
= ()

unfold
let ma_update_sim_participant_session_state
      (s: ideal_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: sim_participant_session_state)
    : ideal_proto_state =
  {
    s with
    internal =
    {
      s.internal with
      sim_participant_sessions =
        PartialMap.upd s.internal.sim_participant_sessions participant
          (PartialMap.upd (ma_sim_participant_sessions s participant) session session_state)
    }
  }

val ma_get_sim_participant_session_state_after_update_same
      (s: ideal_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: sim_participant_session_state)
    : Lemma
      (ensures (
        let s' = ma_update_sim_participant_session_state s participant session session_state
        in
        ma_get_sim_participant_session_state s' participant session == Some session_state
      ))

val ma_get_sim_participant_session_state_after_update_different
      (s: ideal_proto_state)
      (participant: participant_id)
      (session: session_id)
      (session_state: sim_participant_session_state)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (requires (query_participant <> participant \/ query_session <> session))
      (ensures (
        let s' = ma_update_sim_participant_session_state s participant session session_state
        in
        ma_get_sim_participant_session_state s' query_participant query_session ==
        ma_get_sim_participant_session_state s query_participant query_session
      ))

/// Fresh simulator nonces should not already be threaded through simulator
/// state or present in queued inputs. This mirrors the implementation-side
/// freshness predicate and keeps the simulated nonce-equalities unambiguous.

unfold
let ma_sim_nonce_is_fresh
      (s: Protocol.state term ideal_internal_state)
      (fresh_nonce: nonce)
    : prop =
  not (Set.mem fresh_nonce s.internal.used_nonces)

(**
  Ideal initiation (Internal): consume `Auth(i, p, p', r)`, record the request,
  and leak `Authenticating(i, p, p', r)` to the simulator. A participant may
  make at most one request per session. This matches the implementation and
  simulator maps that store a single participant-local session entry.
*)

unfold
let ma_ideal_initiate_enabled
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : prop =
  let request = {party = party; peer = peer; role = r} in
  (forall (stored_request: auth_request).
    Set.mem stored_request (ma_session_requests s session) ==>
    stored_request.party <> party) /\
  Bag.mem (ma_auth_input_term session party peer r) s.inputs

let ma_ideal_initiate_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Protocol.state term ideal_internal_state =
  let request = {party = party; peer = peer; role = r} in
  {
    inputs = Bag.remove (ma_auth_input_term session party peer r) s.inputs;
    internal =
    {
      s.internal with
      // Store that this authentication request has been received for the session.
      requests = PartialMap.upd s.internal.requests session
        (Set.add request (ma_session_requests s session));
      // Leak that these parties are authenticating.
      ideal_to_sim_channel = Set.add (ma_authenticating_term session party peer r)
        s.internal.ideal_to_sim_channel
    }
  }

val ma_ideal_initiate_state_preserves_key_directory
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_ideal_initiate_state s session party peer r).internal.key_directory]

val ma_ideal_initiate_state_preserves_corrupt
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).internal.corrupt ==
        s.internal.corrupt)
      [SMTPat (ma_ideal_initiate_state s session party peer r).internal.corrupt]

val ma_ideal_initiate_state_preserves_used_nonces
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).internal.used_nonces ==
        s.internal.used_nonces)
      [SMTPat (ma_ideal_initiate_state s session party peer r).internal.used_nonces]

val ma_ideal_initiate_state_session_requests_eq
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
      (query_session: session_id)
    : Lemma
      (ensures
        ma_session_requests (ma_ideal_initiate_state s session party peer r) query_session ==
        (if query_session = session then
          Set.add { party = party; peer = peer; role = r } (ma_session_requests s session)
        else
          ma_session_requests s query_session))
      [SMTPat (ma_session_requests (ma_ideal_initiate_state s session party peer r) query_session)]

val ma_ideal_initiate_state_preserves_get_sim_participant_session_state
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures
        ma_get_sim_participant_session_state
          (ma_ideal_initiate_state s session party peer r)
          query_participant query_session ==
        ma_get_sim_participant_session_state s query_participant query_session)
      [SMTPat (ma_get_sim_participant_session_state
        (ma_ideal_initiate_state s session party peer r)
        query_participant query_session)]

val ma_ideal_initiate_state_inputs_eq
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).inputs ==
        Bag.remove (ma_auth_input_term session party peer r) s.inputs)
      [SMTPat (ma_ideal_initiate_state s session party peer r).inputs]

val ma_ideal_initiate_state_ideal_to_sim_channel_eq
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).internal.ideal_to_sim_channel ==
        Set.add (ma_authenticating_term session party peer r) s.internal.ideal_to_sim_channel)
      [SMTPat (ma_ideal_initiate_state s session party peer r).internal.ideal_to_sim_channel]

val ma_ideal_initiate_state_preserves_sim_to_ideal_channel
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : Lemma
      (ensures
        (ma_ideal_initiate_state s session party peer r).internal.sim_to_ideal_channel ==
        s.internal.sim_to_ideal_channel)
      [SMTPat (ma_ideal_initiate_state s session party peer r).internal.sim_to_ideal_channel]

let ma_ideal_initiate_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  ma_ideal_initiate_enabled s session party peer r /\
  s' == ma_ideal_initiate_state s session party peer r


(**
  The simulator transitions below are chosen so that, when composed with the
  ideal transitions above, the resulting traces mirror the five NSL
  implementation transitions.

  - `ma_ideal_initiate` followed by `ma_sim_send_message1` matches NSL
    `nsl_initiator_start`:
    the ideal step consumes `Auth(i, A, B, Initiator)` and records the request,
    while the simulator chooses a fresh nonce and emits the first ciphertext.

  - `ma_ideal_initiate` followed by `ma_sim_send_message2` matches NSL
    `nsl_responder_reply`:
    the ideal step consumes `Auth(i, B, A, Responder)`, and the simulator then
    consumes the replayed first network message, chooses a fresh responder
    nonce, and emits the second ciphertext.

  - `ma_sim_send_message3` matches NSL `nsl_initiator_ack` on the network and
    also forwards `Output(i, A)` to the ideal functionality, so the
    subsequent ideal-deliver step matches NSL `nsl_initiator_output`.

  - `ma_sim_receive_message3` consumes the replayed third network message and
    forwards `Output(i, B)` to the ideal functionality, so the subsequent
    ideal-deliver step matches NSL `nsl_responder_output`.
*)

unfold
let ma_sim_send_message1_enabled
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : prop =
  Set.mem (ma_authenticating_term session initiator responder Initiator)
    s.internal.ideal_to_sim_channel /\
  not (PartialMap.contains (ma_sim_participant_sessions s initiator) session) /\
  PartialMap.sel s.internal.key_directory responder == Some (PubKey?.priv responder_pubkey) /\
  ma_sim_nonce_is_fresh s initiator_nonce

let ma_sim_send_message1_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Protocol.state term ideal_internal_state =
  let s' = ma_update_sim_participant_session_state s initiator session
    (SimInitiatorSession
      {
      initiator = initiator;
      responder = responder;
      initiator_nonce = initiator_nonce;
      ack_sent = false
      })
  in
  {
    s' with
    internal =
    {
      s'.internal with
      used_nonces = Set.add initiator_nonce s.internal.used_nonces;
      ideal_to_sim_channel = Set.remove
        (ma_authenticating_term session initiator responder Initiator)
        s.internal.ideal_to_sim_channel
    }
  }

val ma_sim_send_message1_state_preserves_inputs
      (s: ideal_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_sim_send_message1_state s session initiator responder initiator_nonce).inputs ==
        s.inputs)
      [SMTPat (ma_sim_send_message1_state s session initiator responder initiator_nonce).inputs]

val ma_sim_send_message1_state_preserves_key_directory
      (s: ideal_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.key_directory]

val ma_sim_send_message1_state_preserves_corrupt
      (s: ideal_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.corrupt ==
        s.internal.corrupt)
      [SMTPat (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.corrupt]

val ma_sim_send_message1_state_preserves_used_nonces
      (s: ideal_proto_state)
      (session: session_id)
      (initiator responder: participant_id)
      (initiator_nonce: nonce)
    : Lemma
      (ensures
        (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.used_nonces ==
        Set.add initiator_nonce s.internal.used_nonces)
      [SMTPat (ma_sim_send_message1_state s session initiator responder initiator_nonce).internal.used_nonces]

let ma_sim_send_message1_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (sent_t: term)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  exists (initiator_nonce: nonce)
         (responder_pubkey: term {PubKey? responder_pubkey}).
    ma_sim_send_message1_enabled s session initiator responder initiator_nonce responder_pubkey /\
    sent_t == ma_nsl_message1_term session initiator responder initiator_nonce responder_pubkey /\
    s' == ma_sim_send_message1_state s session initiator responder initiator_nonce


unfold
let ma_sim_send_message2_enabled
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
      (initiator_pubkey: term {PubKey? initiator_pubkey})
    : prop =
  Set.mem (ma_authenticating_term session responder initiator Responder)
    s.internal.ideal_to_sim_channel /\
  not (PartialMap.contains (ma_sim_participant_sessions s responder) session) /\
  PartialMap.sel s.internal.key_directory responder == Some responder_key /\
  PartialMap.sel s.internal.key_directory initiator == Some (PubKey?.priv initiator_pubkey) /\
  ma_sim_nonce_is_fresh s responder_nonce /\
  Bag.mem (ma_nsl_message1_network_term
    session initiator responder initiator_nonce (PubKey responder_key)) s.inputs

let ma_sim_send_message2_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : Protocol.state term ideal_internal_state =
  let s' = ma_update_sim_participant_session_state s responder session
    (SimResponderSession
      {
      responder = responder;
      initiator = initiator;
      responder_nonce = responder_nonce;
      output_forwarded = false
      })
  in
  {
    s' with
    inputs = Bag.remove (ma_nsl_message1_network_term
      session initiator responder initiator_nonce (PubKey responder_key)) s.inputs;
    internal =
    {
      s'.internal with
      used_nonces = Set.add responder_nonce s.internal.used_nonces;
      ideal_to_sim_channel = Set.remove
        (ma_authenticating_term session responder initiator Responder)
        s.internal.ideal_to_sim_channel
    }
  }

val ma_sim_send_message2_state_inputs_eq
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
    : Lemma
      (ensures
        (ma_sim_send_message2_state s session responder initiator initiator_nonce responder_nonce responder_key).inputs ==
        Bag.remove (ma_nsl_message1_network_term
          session initiator responder initiator_nonce (PubKey responder_key)) s.inputs)
      [SMTPat (ma_sim_send_message2_state s session responder initiator initiator_nonce responder_nonce responder_key).inputs]

