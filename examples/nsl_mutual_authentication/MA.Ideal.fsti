      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (responder_key: priv_key)
    : Lemma
      (requires (
        match ma_sim_responder_session_state s responder session with
        | Some rstate ->
          Bag.mem (ma_nsl_message3_network_term
            session initiator responder rstate.responder_nonce
            (PubKey responder_key)) s.inputs
        | None -> False))
      (ensures (
        let rstate = Some?.v (ma_sim_responder_session_state s responder session) in
        (ma_sim_receive_message3_state s session responder initiator responder_key).inputs ==
        Bag.remove (ma_nsl_message3_network_term
          session initiator responder rstate.responder_nonce (PubKey responder_key))
          s.inputs))

let ma_sim_receive_message3_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  exists (responder_key: priv_key).
    ma_sim_receive_message3_enabled s session responder initiator responder_key /\
    s' == ma_sim_receive_message3_state s session responder initiator responder_key


(**
  Ideal deliver (Observable IoSend): once both complementary authentication
  requests exist for the session and `Output(i, p)` has been received, emit
  `Authenticated(i, p, p', r)`.
*)

unfold
let ma_ideal_deliver_enabled
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
    : prop =
  let request = {party = party; peer = peer; role = r} in
  let complementary_request = complementary_request party peer r in
  let at_least_one_corrupt =
    Set.mem party s.internal.corrupt \/ Set.mem peer s.internal.corrupt
  in
  Set.mem (ma_output_term session party) s.internal.sim_to_ideal_channel /\
  Set.mem request (ma_session_requests s session) /\
  (at_least_one_corrupt \/ Set.mem complementary_request (ma_session_requests s session))

let ma_ideal_deliver_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
    : Protocol.state term ideal_internal_state =
  {
    s with
    internal =
    {
      s.internal with
      // Only remove the delivery command from the sim-to-ideal channel. The
      // output term is given in the transition label (until composed with a
      // tester).
      sim_to_ideal_channel = Set.remove (ma_output_term session party)
        s.internal.sim_to_ideal_channel
    }
  }

val ma_ideal_deliver_state_preserves_inputs
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
    : Lemma
      (ensures (ma_ideal_deliver_state s session party peer).inputs == s.inputs)
      [SMTPat (ma_ideal_deliver_state s session party peer).inputs]

val ma_ideal_deliver_state_preserves_key_directory
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
    : Lemma
      (ensures
        (ma_ideal_deliver_state s session party peer).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_ideal_deliver_state s session party peer).internal.key_directory]

val ma_ideal_deliver_state_preserves_corrupt
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
    : Lemma
      (ensures
        (ma_ideal_deliver_state s session party peer).internal.corrupt ==
        s.internal.corrupt)
      [SMTPat (ma_ideal_deliver_state s session party peer).internal.corrupt]

val ma_ideal_deliver_state_session_requests_eq
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures
        ma_session_requests (ma_ideal_deliver_state s session party peer) query_session ==
        ma_session_requests s query_session)
      [SMTPat (ma_session_requests (ma_ideal_deliver_state s session party peer) query_session)]

val ma_ideal_deliver_state_preserves_get_sim_participant_session_state
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures (
        let s' = ma_ideal_deliver_state s session party peer in
        ma_get_sim_participant_session_state s' query_participant query_session ==
        ma_get_sim_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_sim_participant_session_state
        (ma_ideal_deliver_state s session party peer)
        query_participant query_session)]

val ma_ideal_deliver_state_preserves_used_nonces
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
    : Lemma
      (ensures
        (ma_ideal_deliver_state s session party peer).internal.used_nonces ==
        s.internal.used_nonces)
      [SMTPat (ma_ideal_deliver_state s session party peer).internal.used_nonces]

val ma_ideal_deliver_state_preserves_ideal_to_sim_channel
      (s: ideal_proto_state)
      (session: session_id)
      (party peer: participant_id)
    : Lemma
      (ensures
        (ma_ideal_deliver_state s session party peer).internal.ideal_to_sim_channel ==
        s.internal.ideal_to_sim_channel)
      [SMTPat (ma_ideal_deliver_state s session party peer).internal.ideal_to_sim_channel]

let ma_ideal_deliver_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (party peer: participant_id)
      (r: role)
      (output_t: term)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  output_t == ma_authenticated_term session party peer /\
  ma_ideal_deliver_enabled s session party peer r /\
  s' == ma_ideal_deliver_state s session party peer


let ma_ideal_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (l: Protocol.label term ma_effect ma_label_id)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  match l with
  | Protocol.Observable NetSend sent_t lid ->
    (match lid.role with
     | Initiator ->
       ma_sim_send_message1_protocol_transition s lid.session lid.party lid.peer sent_t s' \/
       ma_sim_send_message3_protocol_transition s lid.session lid.party lid.peer sent_t s'
     | Responder ->
       ma_sim_send_message2_protocol_transition s lid.session lid.party lid.peer sent_t s')
  | Protocol.Observable IoSend output_t lid ->
    ma_ideal_deliver_protocol_transition s lid.session lid.party lid.peer lid.role output_t s'
  | Protocol.Internal lid ->
    ma_ideal_initiate_protocol_transition s lid.session lid.party lid.peer lid.role s' \/
    (match lid.role with
     | Responder ->
       ma_sim_receive_message3_protocol_transition s lid.session lid.party lid.peer s'
     | Initiator -> False)

/// The initial used-nonce set is *derived* from the adversary's starting
/// knowledge `know0` rather than supplied independently.  This makes
/// `used_nonces == ma_knowledge_nonces know0` true *by construction*, so a caller
/// cannot desynchronise it from the actual `know0` (which a fresh session nonce
/// must avoid for the knowledge-structure invariants to hold).
let ma_ideal_protocol_init
      (key_directory: PartialMap.t participant_id priv_key)
      (corrupt: Set.set participant_id)
      (know0: knowledge term)
    : Protocol.state term ideal_internal_state =
  {
    inputs = Bag.empty;
    internal =
    {
      key_directory = key_directory;
      corrupt = corrupt;
      requests = PartialMap.empty session_id (Set.set auth_request);
      used_nonces = ma_knowledge_nonces know0;
      ideal_to_sim_channel = Set.empty;
      sim_to_ideal_channel = Set.empty;
      sim_participant_sessions = PartialMap.empty participant_id sim_participant_session_map
    }
  }



/// Internal steps remove one input with `Bag.remove`; observable steps leave
/// the input bag unchanged.

val ma_ideal_valid_transitions
      (s: Protocol.state term ideal_internal_state)
      (l: Protocol.label term ma_effect ma_label_id)
      (s': Protocol.state term ideal_internal_state)
    : squash (ma_ideal_protocol_transition s l s' ==> Bag.subset s'.inputs s.inputs)

[@@ FStar.Tactics.Typeclasses.tcinstance]
let ma_ideal_protocol_with_knowledge
      (key_directory: PartialMap.t participant_id priv_key)
      (corrupt: Set.set participant_id)
      (know0: knowledge term)
    : Protocol.protocol term ma_effect ma_label_id ideal_internal_state =
  {
    transition = ma_ideal_protocol_transition;
    init = ma_ideal_protocol_init key_directory corrupt know0;
    valid_transitions = ma_ideal_valid_transitions
  }

/// Convenience constructor used where only the transition relation matters (the
/// initial state is irrelevant): the empty initial knowledge yields an empty
/// `used_nonces`.
let ma_ideal_protocol
      (key_directory: PartialMap.t participant_id priv_key)
      (corrupt: Set.set participant_id)
    : Protocol.protocol term ma_effect ma_label_id ideal_internal_state =
  ma_ideal_protocol_with_knowledge key_directory corrupt Seq.empty
