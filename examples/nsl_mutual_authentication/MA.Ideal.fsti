val ma_sim_send_message2_state_get_updated_sim_participant_session_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (initiator_nonce responder_nonce: nonce)
      (responder_key: priv_key)
      (query_participant: participant_id)
      (query_session: session_id)
    : Lemma
      (ensures (
        let s' = ma_sim_send_message2_state s session responder initiator initiator_nonce responder_nonce responder_key in
        if query_participant = responder && query_session = session then
          ma_get_sim_participant_session_state s' query_participant query_session ==
          Some (SimResponderSession
            {
              responder = responder;
              initiator = initiator;
              responder_nonce = responder_nonce;
              output_forwarded = false
            })
        else
          ma_get_sim_participant_session_state s' query_participant query_session ==
          ma_get_sim_participant_session_state s query_participant query_session
      ))
      [SMTPat (ma_get_sim_participant_session_state
        (ma_sim_send_message2_state s session responder initiator initiator_nonce responder_nonce responder_key)
        query_participant query_session)]

let ma_sim_send_message2_protocol_transition
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (responder initiator: participant_id)
      (sent_t: term)
      (s': Protocol.state term ideal_internal_state)
    : prop =
  exists (initiator_nonce responder_nonce: nonce)
         (responder_key: priv_key)
         (initiator_pubkey: term {PubKey? initiator_pubkey}).
    ma_sim_send_message2_enabled
      s session responder initiator initiator_nonce responder_nonce responder_key initiator_pubkey /\
    sent_t == ma_nsl_message2_term
      session initiator responder initiator_nonce responder_nonce initiator_pubkey /\
    s' == ma_sim_send_message2_state
      s session responder initiator initiator_nonce responder_nonce responder_key


unfold
let ma_sim_send_message3_enabled
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
      (responder_pubkey: term {PubKey? responder_pubkey})
    : prop =
  match ma_sim_initiator_session_state s initiator session with
  | Some initiator_state ->
    initiator_state.initiator == initiator /\
    initiator_state.responder == responder /\
    not initiator_state.ack_sent /\
    PartialMap.sel s.internal.key_directory initiator == Some initiator_key /\
    PartialMap.sel s.internal.key_directory responder == Some (PubKey?.priv responder_pubkey) /\
    Bag.mem (ma_nsl_message2_network_term
      session initiator responder initiator_state.initiator_nonce responder_nonce
      (PubKey initiator_key)) s.inputs
  | None -> False

let ma_sim_send_message3_state
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Protocol.state term ideal_internal_state =
  match ma_sim_initiator_session_state s initiator session with
  | Some initiator_state ->
    let s' = ma_update_sim_participant_session_state s initiator session
      (SimInitiatorSession { initiator_state with ack_sent = true })
    in
    {
      s' with
      inputs = Bag.remove (ma_nsl_message2_network_term
        session initiator responder initiator_state.initiator_nonce responder_nonce
        (PubKey initiator_key)) s.inputs;
      internal =
      {
        s'.internal with
        sim_to_ideal_channel = Set.add (ma_output_term session initiator)
          s.internal.sim_to_ideal_channel
      }
    }
  | None -> s

(**
  Lemmas characterizing the new state from executing
  `ma_sim_send_message3_transition`. These allow for reasoning about the new
  state without needing to unfold the changes, which could otherwise lead to
  flaky proofs.
*)
val ma_sim_send_message3_state_inputs_eq
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Lemma
      (requires Some? (ma_sim_initiator_session_state s initiator session))
      (ensures (
        let initiator_state = Some?.v (ma_sim_initiator_session_state s initiator session) in
        (ma_sim_send_message3_state s session initiator responder responder_nonce initiator_key).inputs ==
          Bag.remove (ma_nsl_message2_network_term
            session initiator responder initiator_state.initiator_nonce responder_nonce
            (PubKey initiator_key)) s.inputs
      ))
      [SMTPat (ma_sim_send_message3_state s session initiator responder responder_nonce initiator_key).inputs]

val ma_sim_send_message3_state_preserves_key_directory
      (s: Protocol.state term ideal_internal_state)
      (session: session_id)
      (initiator responder: participant_id)
      (responder_nonce: nonce)
      (initiator_key: priv_key)
    : Lemma
      (ensures
        (ma_sim_send_message3_state s session initiator responder responder_nonce initiator_key).internal.key_directory ==
        s.internal.key_directory)
      [SMTPat (ma_sim_send_message3_state s session initiator responder responder_nonce initiator_key).internal.key_directory]

